# ─────────────────────────────────────────────────────────────
# Audio Mods — variables de entorno
# Copia este archivo como .env en la raíz del proyecto.
# La app funciona sin ninguna de estas claves (modo demo + modo local).
# ─────────────────────────────────────────────────────────────

# Jamendo (https://devportal.jamendo.com → crea una app y copia el Client ID)
# Sin clave, el explorador usa el catálogo demo generado localmente.
JAMENDO_CLIENT_ID=

# Puerto del backend Node
PORT=8787

# Firebase Web SDK (Configuración del proyecto → Tus apps → SDK de JS)
# Sin configuración, la autenticación y los datos funcionan en modo local (localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
